# Leave SUPABASE_* empty to run on the in-memory demo store (resets on restart)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Leave empty to always use the offline SBAR template
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated origins allowed for CORS (local Vite dev). Same-origin on Vercel needs none.
CORS_ORIGINS=http://localhost:5173
